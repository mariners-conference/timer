---
import "carbon-components-svelte/css/g100.css";
import Timer from "../components/Timer.svelte";

const title = "LT Timer";
const description = "発表時間を計測するシンプルなカウントアップタイマー。";
const pageUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site);
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={title} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content="ja_JP" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<main class="app">
			<Timer client:only="svelte" />
		</main>
	</body>
</html>

<style is:global>
	body {
		margin: 0;
		min-height: 100vh;
		background: var(--cds-background, #161616);
		color: var(--cds-text-primary, #f4f4f4);
	}
	.app {
		max-width: 760px;
		margin: 0 auto;
		padding: 2.5rem 1.25rem 4rem;
	}
</style>
